    <joint name="torso_joint" type="prismatic">
        <origin xyz="0.150000 0.000000 0.991427" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <parent link="base_link" />
        <child link="torso_link" />
        <!-- Limits derived from assembly geometry (assembly.json + mesh bounds):
             - Rail (Part_1_5.stl / Part 1<1> in Assembly 1) spans z=[−0.032, 1.168] in base_link.
             - Torso joint origin is at z=0.9914 in base_link.
             - The LiDAR top-mount plate (Part 13<1> / Part_13_1.stl) sits at z≈1.168 in base_link
               (i.e. the physical hard stop at the rail top).
             - Maximum upward travel = 1.168 − 0.991 = 0.177 m.
             - Upper limit set to 0.15 m to keep a 27 mm safety gap from the hard stop.
             - Lower limit stays at 0.0 (torso rests at joint origin; downward travel
               is constrained by the bottom HGH20 carriage block at z≈0.629). -->
        <limit lower="0.0" upper="0.15" effort="1000.0" velocity="1.0" />
        <dynamics damping="50.0" friction="5.0" />
    </joint>
