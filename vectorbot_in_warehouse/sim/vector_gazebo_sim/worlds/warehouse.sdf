<?xml version="1.0" ?>
<!--
  warehouse.sdf — Vector robot in a populated warehouse environment.

  Layout based on TurtleBot4's proven warehouse.sdf (which works on
  Gazebo Harmonic). Two important fixes vs a naive Fuel-include:

    1. EXPLICIT GROUND PLANE — the OpenRobotics/Warehouse model alone
       does not provide reliable collision on its floor (the SDFformat
       mesh-as-collision parser sometimes silently drops it). The robot
       falls through. We add an infinite plane at z=0 with collision so
       the robot always has ground to stand on. The warehouse mesh sits
       at z=-0.1 to match (its visual floor lines up with the plane).

    2. POPULATED — explicit shelves, pallets-with-boxes, barriers, and
       chairs are added as separate Fuel models. The base Warehouse
       model is just walls and floor. Furniture comes from MovAi/* and
       OpenRobotics/* on Fuel and downloads on first launch.

  First launch downloads ~80 MB total to ~/.gz/fuel/. Cached after that.
-->
<sdf version="1.10">
  <world name="vector_warehouse">

    <!-- ── Physics & sim plugins (same as empty.sdf) ──────────────── -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Indoor scene — bright ambient instead of sun (warehouse roof blocks sky) -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.5 0.6 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="overhead">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- ════════════════════════════════════════════════════════════════
         GROUND PLANE — explicit, with collision.
         This is THE FIX for "robot falls through floor". The Warehouse
         Fuel model's collision is unreliable, so we put a real plane
         underneath the robot. Friction matches the value in empty.sdf.
         ════════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <!-- No visual on the plane — the warehouse mesh provides the
             visible floor at z=-0.1, so we don't double-paint it.
             If you switch to no-warehouse, uncomment the visual. -->
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         WAREHOUSE STRUCTURE — walls, ceiling, floor mesh
         Positioned at z=-0.1 so its visual floor sits below the
         collision plane (the plane provides the actual physical floor).
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Warehouse</uri>
      <name>warehouse</name>
      <pose>0 0 -0.1 0 0 0</pose>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         SHELVES — large industrial shelves around the perimeter
         Coordinates relative to robot spawn at (0,0).
         X axis: forward/back. Y axis: left/right. Z: up.
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_0</name>
      <pose>-8.5 -13 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_1</name>
      <pose>6.5 -13 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_2</name>
      <pose>-1.5 -13 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_3</name>
      <pose>3.5 9.5 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf_big</uri>
      <name>shelf_big_4</name>
      <pose>-1.3 18.5 0 0 0 1.57</pose>
    </include>

    <!-- Smaller shelves -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_0</name>
      <pose>-10 21.5 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_1</name>
      <pose>-7 23.6 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_2</name>
      <pose>-4 21.5 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_3</name>
      <pose>13.5 4.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_4</name>
      <pose>10 4.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_5</name>
      <pose>13.5 -21 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_6</name>
      <pose>13.5 -15 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
      <name>shelf_7</name>
      <pose>0.4 -2 0 0 0 0</pose>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         PALLETS WITH BOXES — bundled "pallet_box_mobile" Fuel model
         Each one is a wooden pallet stacked with cardboard boxes,
         packaged together. Sprinkled around the warehouse floor at
         varying positions/rotations for visual variety.
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_0</name>
      <pose>3 3 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_1</name>
      <pose>-3 3 0.01 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_2</name>
      <pose>5 -3 0.01 0 0 0.7</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_3</name>
      <pose>-4 -5 0.01 0 0 -0.5</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_4</name>
      <pose>8 8 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_5</name>
      <pose>-9 -2 0.01 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <name>pallet_box_6</name>
      <pose>10 -8 0.01 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         JERSEY BARRIERS — concrete safety barriers (visual variety)
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_0</name>
      <pose>-10.4 14.75 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_1</name>
      <pose>-10.4 10.5 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_2</name>
      <pose>-10.4 6.5 0 0 0 1.57</pose>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         CHAIRS + TABLE — break-room corner of the warehouse
         ════════════════════════════════════════════════════════════════ -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair_0</name>
      <pose>14.3 -5.5 0 0 0 3</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair_1</name>
      <pose>14.3 -4 0 0 0 -3</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table0</name>
      <pose>-12.7 6.5 0 0 0 0</pose>
    </include>

    <!-- ════════════════════════════════════════════════════════════════
         GUI PLUGIN STACK — same structure as empty.sdf, camera moved
         further back/up to frame the larger warehouse environment.
         ════════════════════════════════════════════════════════════════ -->
    <gui fullscreen="0">

      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.5 0.5 0.6</background_color>
        <camera_pose>-8 -8 5 0 0.45 0.78</camera_pose>
        <camera_clip>
          <near>0.01</near>
          <far>1000</far>
        </camera_clip>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">5</property>
          <property type="double" key="width">5</property>
          <property type="double" key="z">0</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="cardBackground">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">5</property>
          <property type="double" key="width">5</property>
          <property type="double" key="z">0</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="cardBackground">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">5</property>
          <property type="double" key="width">5</property>
          <property type="double" key="z">0</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="cardBackground">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="cardBackground">false</property>
          <property type="double" key="anchorsCornerX">0</property>
          <property type="double" key="anchorsCornerY">0</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="cardBackground">false</property>
          <property type="double" key="anchorsCornerX">1</property>
          <property type="double" key="anchorsCornerY">0</property>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>

      <!-- Teleop: WASD keys, sliders, and direction buttons for robot control -->
      <plugin filename="Teleop" name="Teleop">
        <gz-gui>
          <property type="double" key="x">0</property>
          <property type="double" key="y">0</property>
          <property type="double" key="width">400</property>
          <property type="double" key="height">900</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <topic>/cmd_vel</topic>
      </plugin>

    </gui>
  </world>
</sdf>
