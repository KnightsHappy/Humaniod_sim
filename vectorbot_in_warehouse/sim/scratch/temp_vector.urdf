  <!-- Caster wheel - Part 1<3> in Basebottom subassembly (Onshape), Y=-0.224 side -->
  <!-- Caster swivel bracket — rotates freely around Z (yaw) so the ball
         can trail in any direction without transmitting a pitch torque to base. -->
  <link name="caster_swivel_link">
    <inertial>
      <mass value="0.050000"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1.0e-05" ixy="0" ixz="0" iyy="1.0e-05" iyz="0" izz="1.0e-05"/>
    </inertial>
  </link>
  <!-- Swivel joint: free rotation around Z — lets caster align to any direction -->
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin rpy="0 0 0" xyz="0.0433357 -0.224049 -0.094728"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>
  <!-- Caster ball — rolls freely around Y -->
  <link name="caster_link">
    <inertial>
      <mass value="0.240369"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="5.807385832e-05" ixy="0" ixz="0" iyy="5.807385832e-05" iyz="0" izz="5.807385832e-05"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0355"/>
      </geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.0355"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters></parameters>
    </plugin>
  </gazebo>
  <!-- ══════════════════════════════════════════════════════════════════
     IMPORTANT: self_collide is FALSE on every link.
     The original xacro had self_collide=true which caused internal
     mesh collisions between the torso, slider, arms, and base,
     generating violent physics forces that made the robot wobble.
     Only the wheels and casters need collision with the ground plane.
     ══════════════════════════════════════════════════════════════════ -->
  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <self_collide>false</self_collide>
    <gravity>true</gravity>
  </gazebo>
  <gazebo reference="slider_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="torso_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_arm_link_1_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_shoulder_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="right_arm_link_1_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="right_shoulder_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="right_bicep_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_bicep_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="right_forearm_v1_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_forearm_v2_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="neck_v2_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="head_v1_1">
    <self_collide>false</self_collide>
  </gazebo>
  <!-- Wheels: high friction for traction, no self-collide -->
  <gazebo reference="right_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
  </gazebo>
